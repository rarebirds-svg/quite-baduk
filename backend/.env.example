DB_PATH=./data/baduk.db
JWT_SECRET=dev-secret-change-me
KATAGO_BIN_PATH=/usr/local/bin/katago
KATAGO_MODEL_PATH=/katago/models/b18c384nbt-humanv0.bin.gz
KATAGO_CONFIG_PATH=/katago/config.cfg
KATAGO_MOCK=true
# 웹 + 앱 셸 오리진. Android Capacitor WebView는 https://localhost,
# iOS(후속)는 capacitor://localhost 를 추가해야 한다.
CORS_ORIGINS=http://localhost:3000,https://inkbaduk.com,https://localhost
# 방문 통계 — 구글 Search Console (검색어 자동 동기화). 미설정 시 기능 off.
GSC_PROPERTY_URL=sc-domain:inkbaduk.com
GSC_SERVICE_ACCOUNT_JSON=/Users/daegong/.baduk-gsc-key.json
